<div id="settings_plugin_tabiframe" class="tabiframe-settings">
    <h4>{{ _('Custom Tab Configuration') }}</h4>

    <form class="form-horizontal">
        <div class="control-group">
            <label class="control-label" for="tabiframe_title">{{ _('Tab Title') }}</label>
            <div class="controls">
                <input type="text" class="input-block-level" id="tabiframe_title"
                       data-bind="value: settings.plugins.tabiframe.title"
                       placeholder="My Custom Tab">
            </div>
        </div>

        <div class="control-group">
            <label class="control-label" for="tabiframe_url">{{ _('URL') }}</label>
            <div class="controls">
                <input type="text" class="input-block-level" id="tabiframe_url"
                       data-bind="value: settings.plugins.tabiframe.url"
                       placeholder="https://example.com">
                <span class="help-inline">{{ _('The URL to display in the iframe') }}</span>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label" for="tabiframe_icon">{{ _('Icon') }}</label>
            <div class="controls">
                <select class="input-block-level" id="tabiframe_icon"
                        data-bind="value: settings.plugins.tabiframe.icon">
                    <option value="globe">{{ _('Globe') }}</option>
                    <option value="link">{{ _('Link') }}</option>
                    <option value="external-link">{{ _('External Link') }}</option>
                    <option value="window">{{ _('Window') }}</option>
                    <option value="folder">{{ _('Folder') }}</option>
                    <option value="file">{{ _('File') }}</option>
                    <option value="camera">{{ _('Camera') }}</option>
                    <option value="print">{{ _('Print') }}</option>
                    <option value="cog">{{ _('Settings') }}</option>
                    <option value="info">{{ _('Info') }}</option>
                    <option value="question">{{ _('Help') }}</option>
                    <option value="star">{{ _('Star') }}</option>
                    <option value="heart">{{ _('Heart') }}</option>
                    <option value="bell">{{ _('Bell') }}</option>
                    <option value="clock">{{ _('Clock') }}</option>
                </select>
            </div>
        </div>
    </form>

    <div class="alert alert-info">
        <strong>{{ _('Note:') }}</strong> {{ _('Click Save below to apply changes. Refresh the page to see your tab.') }}
    </div>
</div>

